# Server-side provider credentials only. Never prefix these with REACT_APP_.
GOOGLE_TTS_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_KEY2=
AZURE_SPEECH_REGION=koreacentral

# Vercel requires a Cloudflare Turnstile site key and secret as a pair.
REACT_APP_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
